{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xforge.dev/schemas/test-config.schema.json",
  "title": "XForge Test Configuration",
  "description": "Schema for .xforge/test/config.yaml (blueprint §26).",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "object" },
    "sources": { "type": "object" },
    "figma": { "type": "object" },
    "testability": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["read-only", "test-support", "production-modification"]
        }
      }
    },
    "devices": { "type": "array" },
    "workers": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "feature",
            "device",
            "test-type",
            "risk",
            "balanced-duration"
          ]
        }
      }
    },
    "responsive": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "expand_types": { "type": "array", "items": { "type": "string" } },
        "dynamic_type_sizes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "appearances": {
          "type": "array",
          "items": { "enum": ["light", "dark"] }
        }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "grant_permissions": { "type": "boolean" },
        "deep_link_mode": { "enum": ["launch-arg", "os"] },
        "fresh_install_for_ftu": { "type": "boolean" },
        "max_buckets_per_feature": { "type": "integer", "minimum": 1 }
      }
    },
    "navigation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "graph": { "type": "string" },
        "min_edge_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_path_length": { "type": "integer", "minimum": 1 }
      }
    },
    "planning": {
      "type": "object",
      "properties": { "fail_on_deviation": { "type": "boolean" } }
    },
    "execution": { "type": "object" },
    "visual": {
      "type": "object",
      "properties": {
        "conformance_enabled": { "type": "boolean" },
        "conformance_fails_at": {
          "description": "Lowest finding severity that fails a case. `critical` (an element the design has that the app never rendered) is unambiguous and fails by default; size and token deltas start as warnings.",
          "enum": ["critical", "major", "minor", "never"]
        },
        "layout_tolerance_points": { "type": "number", "minimum": 0 },
        "layout_failure_points": { "type": "number", "minimum": 0 },
        "min_tap_points": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "performance": { "type": "object" },
    "output": { "type": "object" }
  }
}
