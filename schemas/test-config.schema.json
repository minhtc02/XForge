{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xforge.dev/schemas/test-config.schema.json",
  "title": "XForge Test Configuration",
  "description": "Schema for .xforge/test/config.yaml (blueprint §26).",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "object" },
    "sources": { "type": "object" },
    "figma": { "type": "object" },
    "testability": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["read-only", "test-support", "production-modification"]
        }
      }
    },
    "devices": { "type": "array" },
    "workers": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "feature",
            "device",
            "test-type",
            "risk",
            "balanced-duration"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "grant_permissions": { "type": "boolean" },
        "deep_link_mode": { "enum": ["launch-arg", "os"] },
        "fresh_install_for_ftu": { "type": "boolean" },
        "max_buckets_per_feature": { "type": "integer", "minimum": 1 }
      }
    },
    "navigation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "graph": { "type": "string" },
        "min_edge_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_path_length": { "type": "integer", "minimum": 1 }
      }
    },
    "planning": {
      "type": "object",
      "properties": { "fail_on_deviation": { "type": "boolean" } }
    },
    "execution": { "type": "object" },
    "visual": { "type": "object" },
    "performance": { "type": "object" },
    "output": { "type": "object" }
  }
}
