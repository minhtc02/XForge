{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xforge.dev/schemas/config.schema.json",
  "title": "XForge Configuration",
  "description": "Schema for .xforge/config.yaml (blueprint §18).",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["ios-swift", "generic"] },
        "name": { "type": "string" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "type": "string" } },
        "project_docs": {
          "description": "The project's own documentation, which XForge only ever reads. Default source of truth for `xforge docs`; kept distinct from output.root so a run never ingests its own output.",
          "type": "array",
          "items": { "type": "string" }
        },
        "prd": { "type": "array", "items": { "type": "string" } },
        "speckit": { "type": "array", "items": { "type": "string" } },
        "bmad": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "description": "Where XForge writes. Must not overlap sources.project_docs.",
          "type": "string"
        },
        "format": { "enum": ["markdown"] },
        "diagrams": { "enum": ["mermaid", "none"] },
        "language": { "type": "string" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_code_references": { "type": "boolean" },
        "include_prd_traceability": { "type": "boolean" },
        "include_tests": { "type": "boolean" },
        "detect_feature_gaps": { "type": "boolean" },
        "preserve_manual_blocks": { "type": "boolean" },
        "minimum_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "publish_full_model": {
          "description": "Publish the complete model (inventories included) as _meta/project-model.json. .xforge/state/ always keeps the split form.",
          "type": "boolean"
        },
        "docs_source": {
          "description": "Which truth `xforge docs` leads with. `project-docs` (default): documents state intent and win on conflict. `code`: the repository leads and project documents do not create requirements. Overridable per run with --from-docs / --from-code.",
          "enum": ["project-docs", "code"]
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
