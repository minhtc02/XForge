{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xforge.dev/schemas/config.schema.json",
  "title": "XForge Configuration",
  "description": "Schema for .xforge/config.yaml (blueprint §18).",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["ios-swift", "generic"] },
        "name": { "type": "string" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "type": "string" } },
        "prd": { "type": "array", "items": { "type": "string" } },
        "speckit": { "type": "array", "items": { "type": "string" } },
        "bmad": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string" },
        "format": { "enum": ["markdown"] },
        "diagrams": { "enum": ["mermaid", "none"] },
        "language": { "type": "string" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_code_references": { "type": "boolean" },
        "include_prd_traceability": { "type": "boolean" },
        "include_tests": { "type": "boolean" },
        "detect_feature_gaps": { "type": "boolean" },
        "preserve_manual_blocks": { "type": "boolean" },
        "minimum_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
