{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xforge.dev/schemas/test-plan.schema.json",
  "title": "XForge Test Plan",
  "description": "Schema for .xforge/test/plans/<plan-id>/plan.json (blueprint §5.3, §8).",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "level",
    "test_cases",
    "permissions",
    "stats",
    "inputs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^XFPLAN-" },
    "project_id": { "type": "string" },
    "created_at": { "type": "string" },
    "level": { "enum": ["smoke", "critical", "regression", "full"] },
    "feature_filter": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "array", "items": { "type": "string" } },
    "test_cases": { "type": "array" },
    "suites": { "type": "array" },
    "shards": { "type": "array" },
    "testability_issues": { "type": "array" },
    "testability_mode": {
      "enum": ["read-only", "test-support", "production-modification"]
    },
    "permissions": { "type": "object" },
    "production_modifications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "estimated_duration": {
      "type": "object",
      "properties": {
        "min_minutes": { "type": "number" },
        "max_minutes": { "type": "number" }
      }
    },
    "stats": { "type": "object" },
    "inputs": {
      "type": "object",
      "required": ["config_version"],
      "properties": {
        "source_commit": { "type": "string" },
        "config_version": { "type": "integer" },
        "project_model_hash": { "type": "string" },
        "figma_snapshot_version": { "type": "string" },
        "design_map_hash": { "type": "string" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
