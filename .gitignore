# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Editor
.vscode/
.idea/

# XForge runtime state (do not commit caches/logs)
.xforge/cache/
.xforge/logs/

# XForge Test run artifacts: screenshots, .xcresult bundles and DerivedData.
# These are large, machine-specific and regenerated by every run.
qa-runs/
.xforge/test/DerivedData/

# Xcode build output (a consuming iOS project may build inside this tree)
DerivedData/
*.xcuserstate
xcuserdata/

# Generated CLI bundle (built by `pnpm build`)
apps/cli/bundle/

# npm pack output
*.tgz
