{
  "name": "@xforge/cli",
  "version": "0.2.0",
  "description": "XForge CLI — Project Knowledge Compiler & AI Development Toolkit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ios",
    "swift",
    "documentation",
    "project-model",
    "traceability",
    "qa"
  ],
  "bin": {
    "xforge": "./bundle/xforge.mjs"
  },
  "files": [
    "bundle/xforge.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -b --noEmit false",
    "dev": "tsx src/index.ts",
    "prepack": "pnpm run bundle"
  },
  "devDependencies": {
    "@xforge/core": "workspace:*",
    "@xforge/dev-core": "workspace:*",
    "@xforge/shared": "workspace:*",
    "@xforge/test-core": "workspace:*",
    "commander": "^13.0.0",
    "yaml": "^2.7.0"
  }
}
